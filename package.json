{
  "name": "margin",
  "private": true,
  "version": "0.1.0",
  "description": "Margin: a private, fact-checked learning platform. Courses are plain content files that Claude can author and verify.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "tsx scripts/validate-content.ts",
    "validate:strict": "tsx scripts/validate-content.ts --strict",
    "check-sources": "tsx scripts/check-sources.ts",
    "new:subject": "tsx scripts/new-subject.ts",
    "schema": "tsx scripts/emit-json-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "bash supabase/tests/run-local-postgres.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/gloock": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "katex": "^0.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
